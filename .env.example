# Database - SQLite file path (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Supabase (Phase 4 foundation)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Admin dashboard secret key - change this to a strong random string!
# Access admin at: /growthmvp/admin
ADMIN_SECRET="change-this-to-a-secure-random-string"

# Legacy Prisma/SQLite analytics API (Phase 4F)
# Keep false unless you intentionally use the old activity DB endpoints.
ENABLE_LEGACY_ACTIVITY_DB="false"
